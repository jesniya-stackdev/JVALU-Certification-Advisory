# Copy this file to .env and fill in real values. Never commit .env.

# The Zoho Mail inbox that sends the notification (App Password, not your normal login password —
# create one at https://accounts.zoho.com > Security > App Passwords).
ZOHO_EMAIL=support@jvalu.ae
ZOHO_APP_PASSWORD=

# Inbox that receives consultation requests. Defaults to ZOHO_EMAIL if omitted.
CONTACT_TO_EMAIL=support@jvalu.ae

# Port this API server listens on.
PORT=4000

# Your live site origin, so the API only accepts requests from your own site (CORS).
# Use a comma-separated list if you need more than one (e.g. www + apex domain).
ALLOWED_ORIGIN=https://jvalu.ae
